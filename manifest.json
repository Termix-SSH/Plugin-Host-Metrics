{
  "id": "host-metrics",
  "name": "Host Metrics",
  "version": "1.3.1",
  "description": "Live CPU, memory, disk, network and GPU stats, plus tools to manage your hosts.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Host-Metrics",
  "docs": "https://docs.termix.site/plugins/host-metrics",
  "video": "https://www.youtube.com/watch?v=_psvlU-s7D4",
  "category": "Monitoring",
  "icon": "Activity",
  "features": [
    "CPU, memory, disk, network, temperature, NVIDIA and AMD GPUs, processes, ports and logins",
    "History charts for each host",
    "Manage services, packages, cron jobs, firewall rules, users, SSL certificates, logs and WireGuard",
    "Health checks for your hosts and services",
    "A layout you can rearrange per host",
    "Live stats in the terminal toolbar",
    "A live metrics panel beside any SSH terminal",
    "A dashboard card with the hosts working hardest"
  ],
  "env": [
    {
      "name": "METRICS_POLL_CONCURRENCY",
      "description": "How many hosts to poll at the same time, up to 50. Unset scales with the number of hosts, from 5 to 50."
    }
  ],
  "engine": {
    "termix": ">=26.10.6",
    "api": "^1.9"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "credentials:read",
    "ssh:connect",
    "db:own",
    "network:serve",
    "ui:surface",
    "events:core",
    "users:impersonate",
    "notify:send"
  ],
  "provides": [
    {
      "service": "host-metrics.viewers",
      "version": "1.0.0",
      "permission": "host-metrics.use"
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "host-metrics",
        "titleKey": "nav.hostMetrics",
        "icon": "Activity",
        "openFrom": ["host-context-menu", "palette"]
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "settings": {
      "admin": [
        {
          "key": "metricsInterval",
          "type": "number",
          "labelKey": "settings.admin.metricsInterval.label",
          "descriptionKey": "settings.admin.metricsInterval.description",
          "default": 30,
          "min": 5,
          "max": 3600
        },
        {
          "key": "historyRetentionDays",
          "type": "number",
          "labelKey": "settings.admin.historyRetentionDays.label",
          "descriptionKey": "settings.admin.historyRetentionDays.description",
          "default": 7,
          "min": 1,
          "max": 90
        },
        {
          "key": "liveEnabled",
          "type": "boolean",
          "labelKey": "settings.admin.liveEnabled.label",
          "descriptionKey": "settings.admin.liveEnabled.description",
          "default": true
        },
        {
          "key": "liveMinInterval",
          "type": "number",
          "labelKey": "settings.admin.liveMinInterval.label",
          "descriptionKey": "settings.admin.liveMinInterval.description",
          "default": 2,
          "min": 0.25,
          "max": 3600
        }
      ],
      "user": [
        {
          "key": "temperatureUnit",
          "type": "select",
          "labelKey": "settings.user.temperatureUnit.label",
          "descriptionKey": "settings.user.temperatureUnit.description",
          "default": "celsius",
          "options": [
            {
              "value": "celsius",
              "labelKey": "settings.user.temperatureUnit.celsius"
            },
            {
              "value": "fahrenheit",
              "labelKey": "settings.user.temperatureUnit.fahrenheit"
            }
          ]
        },
        {
          "key": "liveInterval",
          "type": "select",
          "labelKey": "settings.user.liveInterval.label",
          "descriptionKey": "settings.user.liveInterval.description",
          "default": "2",
          "options": [
            {
              "value": "off",
              "labelKey": "settings.user.liveInterval.off"
            },
            {
              "value": "0.5",
              "labelKey": "settings.user.liveInterval.s05"
            },
            {
              "value": "1",
              "labelKey": "settings.user.liveInterval.s1"
            },
            {
              "value": "2",
              "labelKey": "settings.user.liveInterval.s2"
            },
            {
              "value": "5",
              "labelKey": "settings.user.liveInterval.s5"
            }
          ]
        },
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "backgroundGraceS",
          "type": "select",
          "labelKey": "settings.user.backgroundGraceS.label",
          "descriptionKey": "settings.user.backgroundGraceS.description",
          "default": "10",
          "options": [
            { "value": "0", "labelKey": "settings.user.backgroundGraceS.s0" },
            { "value": "5", "labelKey": "settings.user.backgroundGraceS.s5" },
            { "value": "10", "labelKey": "settings.user.backgroundGraceS.s10" },
            { "value": "30", "labelKey": "settings.user.backgroundGraceS.s30" },
            { "value": "60", "labelKey": "settings.user.backgroundGraceS.s60" }
          ]
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 300
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ],
      "host": {
        "fields": [
          {
            "key": "metricsEnabled",
            "type": "boolean",
            "labelKey": "settings.host.metricsEnabled.label",
            "default": true,
            "hidden": true
          },
          {
            "key": "metricsInterval",
            "type": "number",
            "labelKey": "settings.host.metricsInterval.label",
            "min": 5,
            "max": 3600,
            "hidden": true
          },
          {
            "key": "enabledWidgets",
            "type": "json",
            "labelKey": "settings.host.enabledWidgets.label",
            "hidden": true
          },
          {
            "key": "excludedMounts",
            "type": "json",
            "labelKey": "settings.host.excludedMounts.label",
            "hidden": true
          },
          {
            "key": "monitoredMounts",
            "type": "json",
            "labelKey": "settings.host.monitoredMounts.label",
            "hidden": true
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "default": true,
            "hidden": true
          }
        ]
      }
    },
    "actionSlots": [
      {
        "id": "host-metrics.managers",
        "accepts": ["component"]
      },
      {
        "id": "host-metrics.toolbar",
        "accepts": ["component"]
      }
    ],
    "uiPresets": {
      "simple": {
        "columns": 1
      },
      "balanced": {
        "columns": 3
      },
      "advanced": {
        "columns": 4
      }
    },
    "uses": [
      "dashboard.hostRow",
      "dashboard.hostRowBadge",
      "homepage.hostMetrics",
      "homepage.widgets",
      "terminal.toolbarStatus"
    ],
    "dashboardCards": [
      {
        "id": "busiest-hosts",
        "titleKey": "card.title",
        "icon": "Activity"
      }
    ]
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
